{
  "expo": {
    "name": "Peopoll",
    "slug": "peopoll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-font"
    ],
    "ios": {
      "bundleIdentifier": "com.jkapplications.peopoll",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jkapplications.peopoll"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "828cdc2a-a0b7-4420-9ac2-63ee02b6d82d"
      }
    }
  }
}
