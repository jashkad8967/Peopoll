{
  "name": "peopoll",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo build",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:web": "expo export --platform web --output-dir dist && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy:all": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Target all",
    "deploy:update": "eas update --branch production --platform all --message \"OTA update\" --non-interactive",
    "deploy:build": "eas build --platform all --profile production --non-interactive",
    "deploy:submit": "eas submit --platform all --profile production --non-interactive",
    "seed:groups": "node scripts/seedGroups.mjs",
    "seed:trend": "node scripts/seedTrend.mjs",
    "seed:data": "node scripts/seedData.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^6.1.15",
    "@react-navigation/native-stack": "^6.9.18",
    "expo": "~56.0.15",
    "expo-build-properties": "~56.0.22",
    "expo-status-bar": "~56.0.4",
    "firebase": "^10.14.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.22.20",
    "firebase-admin": "^12.7.0"
  },
  "expo": {
    "name": "Peopoll",
    "slug": "peopoll",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
